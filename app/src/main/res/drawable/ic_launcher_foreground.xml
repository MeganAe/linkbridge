<?xml version="1.0" encoding="utf-8"?>
<!--
  Premier plan de l'icône adaptative : le nouveau logo. Ses coins transparents laissent voir
  le fond, de la même couleur violette, donc le carré est continu. Le marquage de 10 % garde
  le dessin dans la zone toujours visible, quel que soit le masque du lanceur.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/linkbridge_icone"
    android:insetLeft="10%"
    android:insetTop="10%"
    android:insetRight="10%"
    android:insetBottom="10%" />
